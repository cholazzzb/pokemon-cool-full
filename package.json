{
  "name": "pokemon_cool",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "postinstall": "[ -z \"$HUSKY\" ] && husky install .husky || echo \"ignore husky\" && pnpm script:compile && pnpm gql:codegen",
    "prepare": "panda codegen",
    "dev": "NODE_ENV=development pnpm script:exec && pnpm gen:icon && next dev --turbopack",
    "build": "pnpm script:exec && pnpm gen:icon && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:preview": "vitest-preview",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e-debug": "PWDEBUG=1 playwright test",
    "script:compile": "tsc scripts/collect-assets.ts --outDir .temp",
    "script:exec": "node .temp/collect-assets.js",
    "gen:icon": "rm -rf src/__generated__/icons && svgr public/assets/icons --config-file .svgrrc.yaml",
    "gql:codegen": "graphql-codegen --config graphql-codegen.ts"
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "pnpm lint",
      "pnpm format"
    ]
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/react-query": "^5.63.0",
    "graphql": "^16.10.0",
    "jotai": "^2.11.0",
    "motion": "^11.17.0",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.12.5",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.12.16",
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "5.0.3",
    "@graphql-codegen/client-preset": "4.5.1",
    "@graphql-codegen/introspection": "4.0.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@pandacss/dev": "^0.51.1",
    "@svgr/cli": "^8.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "eslint-config-prettier": "^9.1.0",
    "fs-extra": "^11.2.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
